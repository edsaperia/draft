node_modules/
dist/
coverage/
*.tsbuildinfo
.env

# the card audit's payload: regenerated by `npm run card-audit`, and one run is
# ~4MB of rects. What is worth keeping is the artifact that reads it.
design/tools/card-audit*.json
# the seat matrix's snapshots, same reasoning: a run is snapshots, not an artifact
design/tools/seat-matrix*.json
# the proposal-shapes walk's payload: one row per assertion, regenerated by
# `npm run proposal-shapes`; the findings are what is worth keeping
design/tools/proposal-shapes*.json
# the accessibility audit's payload, same reasoning: the findings live in
# design/REPORT-a11y.md, the run that produced them does not
design/tools/a11y-audit*.json

# server runtime state: plaintext member emails, magic-link tokens, HMAC secret.
# A public repo must never be one careless `git add` away from these.
packages/server/data/
data/
secret.txt
tokens.json
outbox.jsonl

# Ed's screenshot drop point; the keepers are archived under design/bug-shots-<date>/ (Q1308, 2026-09-10)
bugs/
scripts/repro/*.cookie
