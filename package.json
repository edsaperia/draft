{
  "name": "draft",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test --workspaces",
    "test:pg": "node scripts/test-pg.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "bundle": "npm run bundle -w @draft/constitution",
    "server": "npm run start -w @draft/server",
    "build": "node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "verify": "node scripts/verify-deploy.mjs",
    "probe": "node scripts/probe.mjs",
    "probe-coverage": "node scripts/probe-coverage.mjs",
    "card-audit": "node design/tools/card-audit.mjs",
    "clock-check": "node design/tools/clock-check.mjs",
    "toc-travel": "node design/tools/toc-travel.mjs",
    "journey": "node scripts/journey-walk.mjs",
    "applicants-walk": "node scripts/applicants-walk.mjs",
    "powers-walk": "node scripts/powers-walk.mjs",
    "room-walk": "node scripts/room-walk.mjs",
    "slug-walk": "node scripts/slug-walk.mjs",
    "slider-walk": "node scripts/slider-walk.mjs",
    "ladder": "node scripts/ladder-walk.mjs",
    "seat-matrix": "node scripts/seat-matrix.mjs",
    "founding-golden": "node scripts/founding-golden.mjs",
    "copy-check": "node scripts/copy-check.mjs",
    "copy-freeze": "node scripts/copy-check.mjs --update",
    "qa:freeze": "node scripts/qa-freeze.mjs",
    "emoji-data": "node scripts/emoji-data.mjs",
    "founder-answers": "node scripts/founding-walk.mjs --delegate=chamber",
    "spec-check": "node scripts/spec-check.mjs",
    "design": "node scripts/design-server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "eslint": "^10.8.1",
    "playwright": "1.62.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
}
